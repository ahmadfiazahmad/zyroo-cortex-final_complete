{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/usage-reset",
      "schedule": "0 0 * * *"
    }
  ],
  "env": {
    "EMBEDDING_PROVIDER": "fastembed",
    "MAX_UPLOAD_MB": "4"
  }
}
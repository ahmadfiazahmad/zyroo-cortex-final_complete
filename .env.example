# Cortex AI Backend — copy to .env and paste your own keys. Never commit .env.
DATABASE_URL=sqlite:///./cortex.db
# Production (Neon): use the POOLED connection string from the Neon dashboard,
# e.g. DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# The direct (non-pooler) string is for migrations only, never for the app.
# Production (Render): DATABASE_URL=postgresql://user:password@host:5432/cortex

JWT_SECRET=change-me-to-a-long-random-secret

# Embeddings: "hash" (default, offline, tests) or "fastembed" (real neural
# embeddings, all-MiniLM-L6-v2 — set this in production for true semantic search).
EMBEDDING_PROVIDER=hash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
APP_BASE_URL=http://localhost:8000

# Comma-separated emails that become admin on registration.
ADMIN_EMAILS=

# Secret for Vercel Cron (GET /api/cron/usage-reset). Generate a long random
# value and set the SAME value in Vercel (Dashboard -> Settings -> Environment
# Variables). Not needed for local development or Render.
CRON_SECRET=

# On Vercel, uploads are capped at 4 MB (platform request-body limit ~4.5 MB).
# Locally / on Render the default is 10 MB. Override with MAX_UPLOAD_MB.
MAX_UPLOAD_MB=10
